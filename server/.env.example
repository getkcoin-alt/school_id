# --- Required ---
DATABASE_URL=postgresql://idstudio:idstudio@localhost:5432/idstudio
# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-value-0000
# Where the web app is served (used in emailed links) and where this API is reachable.
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# --- Recommended in production ---
NODE_ENV=development
# Enables background workers (email queue) and shared rate limits across instances.
REDIS_URL=redis://localhost:6379

# --- Files: local disk for one server, s3 for anything bigger (AWS S3, Cloudflare R2, MinIO) ---
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_BUCKET=id-studio
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email: "log" prints emails to the console; "smtp" sends them ---
MAIL_DRIVER=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=ID Card Studio <no-reply@idcardstudio.in>

# --- Tuning ---
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
INVITE_TTL_DAYS=14
MAX_UPLOAD_MB=25
# Phase 2
WHATSAPP_ENABLED=false
